# Everything this project downloads or generates holds real asset data, and none
# of it belongs in the repository. By default it is all written outside the
# clone, under LEAKRELOCATION_WORK_ROOT; these rules are for when it is not.

# Downloaded layers and relocation outputs
layer_cache/
assettype_cache_enrichment/
production_moved_leak_outputs/
outputs/
*.pkl.gz
*.gpkg
*.gpkg-journal
*.gdb/
*.fgdb/
*.sqlite
*.db
*.geojson

# Generated reports: the dashboards embed leak rows and the rollback files
# embed feature geometry.
relocation_distance_dashboard*.html
leak_geometry_rollback_*.json
*_assettype_decode_counts.csv

# Secrets and sign-in artifacts
*token*
*Token*
*.secret
*.secrets
.env
.env.*
credentials.json

# Scratch
*.log
*.bak
*.tmp
*.zip

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
